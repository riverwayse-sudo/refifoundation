{
  "name": "refi-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:live-feed": "node scripts/verify-live-feed.mjs",
    "verify:donations": "node scripts/verify-donations.mjs",
    "verify:games": "node scripts/verify-games.mjs",
    "verify:contact": "node --experimental-strip-types --test scripts/verify-contact.mjs",
    "test:cms": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:rls": "bash scripts/test-rls.sh",
    "cms:snapshot": "node --experimental-strip-types scripts/cms-snapshot.mjs",
    "cms:import": "node scripts/cms-import.mjs",
    "cms:restore": "node scripts/cms-restore.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}
