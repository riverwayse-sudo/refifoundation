{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/cms/cron/keep-alive",
      "schedule": "0 6 * * *"
    }
  ]
}
